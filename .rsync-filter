# rsync filter rules for the deployment (see .github/workflows/deploy.yml)
# "-" = neither uploaded nor deleted on the server
# "P" = uploaded as usual, but never deleted on the server

# This file is only needed by the deployment itself
- /.rsync-filter
# We need .well-known file for Matrix to work correctly – it's not part of the repo but shouldn't be overwritten in the deployments
- /.well-known/
# Config files are deployment-specific and the repo only contains very basic configurations which shouldn't be overwritten
- /site/config/
# User accounts are not part of the repo and should not be overwritten
- /site/accounts/
# Cache is deployment specific and should not be overwritten
- /site/cache/
# Sessions are deployment specific and should not be overwritten
- /site/sessions/
# Logs are deployment specific and should not be overwritten (they also hold the Fabby RAG index)
- /site/logs/
# Languages are deployment specific and should not be overwritten (if they even exist)
- /site/languages/
# Obviously Kirby content should not be overwritten
- /content/
# Media files are generated by Kirby on the server
- /media/

# Anything in the web root that the build doesn't know about (.env etc.) stays on the server
P /*
# Same for plugins that were installed on the server manually
P /site/plugins/*
